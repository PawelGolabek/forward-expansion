// Inherit the parent event
event_inherited();

noEyes = true;
image_index = random(image_number)
defaultSprite = sprite_index;

function initiate2(){
	image_xscale = 3;
	image_yscale = 3;
	sprite_center_offset = (sprite_get_width(sprite_index) / 2);
	og_image_xscale = image_xscale
	og_image_yscale = image_yscale
}